{
  "manifest_version": 3,
  "name": "图片视频音频链接预览",
  "version": "1.8.0",
  "description": "图片/视频/音频链接预览、在线播放、本地 Whisper 转文字（自动繁转简、批量并行）、MD5 导出和文本去重。",
  "permissions": ["storage", "contextMenus", "clipboardRead", "clipboardWrite", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "图片/视频/音频链接预览（⌘⇧Y）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-viewer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开图片/视频/音频链接预览"
    }
  }
}
